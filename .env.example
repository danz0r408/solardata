# Variaveis de ambiente do SolarData (todas opcionais no ambiente local).
# Copie para .env somente na sua maquina. Nunca comite o .env real.

# Contas do app: PostgreSQL em producao. Vazio = SQLite local em api/data/
DATABASE_URL=

# Databricks: perfil da CLI (databricks auth login) e SQL Warehouse
DATABRICKS_PROFILE=solardata
DATABRICKS_WAREHOUSE_ID=
SOLARDATA_CATALOGO=pi-6
# Caminho da Databricks CLI, se ela nao estiver no PATH
DATABRICKS_CLI_PATH=

# Assinatura dos tokens de sessao (obrigatoria no deploy; local, e gerada sozinha)
SOLARDATA_JWT_SECRET=
SOLARDATA_JWT_EXPIRA_DIAS=7

# Cache dos dados em memoria (segundos) e origens permitidas no CORS
SOLARDATA_CACHE_TTL_S=600
SOLARDATA_CORS=*
